<UserControl x:Class="DarkKnightTheme.UI.DarkKnightSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="450"
             Background="#171C25" Foreground="#E6EAF0"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#171C25"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2330"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3445"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#929BA8"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E8B84A"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#4D8DCC"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent"/>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource GoldBrush}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    <Setter TargetName="Border" Property="Background" Value="#1C2330"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style with Custom Dark Dropdown Popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#14171E"/>
            <Setter Property="Foreground" Value="#E6EAF0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#14171E" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="3" Margin="0,2,0,4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14171E"/>
            <Setter Property="Foreground" Value="#E6EAF0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B385C"/>
                                <Setter Property="Foreground" Value="#FFC94A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B385C"/>
                                <Setter Property="Foreground" Value="#E6EAF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- Header Banner -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,0,2" CornerRadius="4,4,0,0" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="BATCAVE WORKSTATION SETTINGS" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldBrush}"/>
                    <TextBlock Text="Configure optional editor background watermark and telemetry aesthetics." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Main Toggle -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="ChkEnableBackground" Content="Enable Batcave Background" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    <TextBlock Text="Images are purely optional decorative watermarks behind code text. Text contrast, selection, IntelliSense, and breakpoints remain 100% accessible."
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Presets Section -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SELECT BACKGROUND PRESET" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                        <!-- Preset 1: Batman & Catwoman -->
                        <Border x:Name="CardPreset1" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="4" Margin="4" Padding="6" Background="#14171E" MouseLeftButtonDown="SelectPreset1" Cursor="Hand">
                            <StackPanel>
                                <Image x:Name="ImgThumb1" Height="65" Stretch="Uniform" Margin="0,0,0,4"/>
                                <TextBlock Text="Batman &amp; Catwoman" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="Moonlit Cathedral Vigil" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Preset 2: Gotham Skyline -->
                        <Border x:Name="CardPreset2" BorderThickness="2" BorderBrush="{StaticResource GoldBrush}" CornerRadius="4" Margin="4" Padding="6" Background="#14171E" MouseLeftButtonDown="SelectPreset2" Cursor="Hand">
                            <StackPanel>
                                <Image x:Name="ImgThumb2" Height="65" Stretch="Uniform" Margin="0,0,0,4"/>
                                <TextBlock Text="Gotham Skyline" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="Batman Nocturnal Overlook" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Preset 3: Joker's Carnival -->
                        <Border x:Name="CardPreset3" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="4" Margin="4" Padding="6" Background="#14171E" MouseLeftButtonDown="SelectPreset3" Cursor="Hand">
                            <StackPanel>
                                <Image x:Name="ImgThumb3" Height="65" Stretch="Uniform" Margin="0,0,0,4"/>
                                <TextBlock Text="Joker's Carnival" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rooftop of Chaos" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Preset 4: Bat-Signal Storm -->
                        <Border x:Name="CardPreset4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="4" Margin="4" Padding="6" Background="#14171E" MouseLeftButtonDown="SelectPreset4" Cursor="Hand">
                            <StackPanel>
                                <Image x:Name="ImgThumb4" Height="65" Stretch="Uniform" Margin="0,0,0,4"/>
                                <TextBlock Text="Bat-Signal Storm" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cloud Searchlight Beam" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Custom Image Option -->
                    <DockPanel LastChildFill="True" Margin="4,4,4,0">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Padding="8,4" Click="BrowseCustomImage_Click"/>
                        <TextBox x:Name="TxtCustomImage" Background="#12151B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4" TextChanged="TxtCustomImage_TextChanged"/>
                    </DockPanel>
                    <TextBlock Text="Or specify a custom background image file (.png, .jpg)." FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="6,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Adjustments Section -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="OPACITY &amp; POSITIONING" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>

                    <!-- Image Opacity -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Image Opacity:" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="LblOpacity" Text="40%" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Slider x:Name="SliderOpacity" Minimum="5" Maximum="100" Value="40" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderOpacity_ValueChanged" Margin="0,0,0,12"/>

                    <!-- Dark Translucent Overlay -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Dark Tint Overlay (#101216):" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="LblOverlay" Text="0%" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Slider x:Name="SliderOverlay" Minimum="0" Maximum="90" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderOverlay_ValueChanged" Margin="0,0,0,12"/>

                    <!-- Positioning -->
                    <TextBlock Text="Alignment / Layout:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPosition" Background="#12151B" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" SelectionChanged="CmbPosition_SelectionChanged" Margin="0,0,0,4">
                        <ComboBoxItem Content="UniformToFill (Full Viewport - Stretched)" Tag="UniformToFill"/>
                        <ComboBoxItem Content="Center (Proportional Fit)" Tag="Center"/>
                        <ComboBoxItem Content="BottomRight (Corner)" Tag="BottomRight"/>
                        <ComboBoxItem Content="TopRight" Tag="TopRight"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Actions and Status -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,12">
                <Button Content="Reset to Defaults" Click="BtnReset_Click" Margin="0,0,8,0" Background="#1C2330"/>
                <Button Content="Apply Changes" Click="BtnApply_Click" Background="{StaticResource GoldBrush}" Foreground="#101216" BorderBrush="{StaticResource GoldBrush}"/>
            </StackPanel>

            <TextBlock x:Name="TxtStatus" Text="Changes take effect immediately across all open editor documents." FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" FontStyle="Italic"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
